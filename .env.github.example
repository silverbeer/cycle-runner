# The GitHub write credential, and nothing else. Only the deliver command is run
# with this file (op run --env-file .env.github -- ... executor deliver WR-...);
# never the bot, never the coding agent (the agent run refuses if it's set).
#
# A fine-grained personal access token limited to the delivery repositories:
# Contents read/write, Pull requests read/write (Metadata read is implied).
# Copy to .env.github (gitignored).
CYCLE_RUNNER_GITHUB_TOKEN=op://agents/cycle-runner-github/token
