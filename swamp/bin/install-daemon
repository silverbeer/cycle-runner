#!/bin/sh
# Install `swamp serve` as a launchd user agent that fires scheduled
# workflows (scrum-report). Re-run after `swamp serve daemon enable`, which
# rewrites the plist back to calling swamp directly.
set -eu
repo="$(cd "$(dirname "$0")/.." && pwd)"
plist="$HOME/Library/LaunchAgents/club.swamp.serve.plist"
swamp serve daemon enable --user --repo-dir "$repo"
plutil -replace ProgramArguments -json \
  "[\"$repo/bin/serve\",\"--repo-dir\",\"$repo\",\"--port\",\"9090\",\"--host\",\"127.0.0.1\"]" \
  "$plist"
launchctl bootout "gui/$(id -u)/club.swamp.serve" 2>/dev/null || true
launchctl bootstrap "gui/$(id -u)" "$plist"
echo "installed: $plist"
